NODE_ENV=production
PORT=3022
PUBLIC_BASE_URL=https://altezzaeventos.in

ALTEZZA_DB_HOST=127.0.0.1
ALTEZZA_DB_PORT=3306
ALTEZZA_DB_NAME=feegosys_Altezza
ALTEZZA_DB_USER=feegosys_Altezza
ALTEZZA_DB_PASS=CHANGE_ME

ALTEZZA_DATA_ROOT=/srv/altezza

# Fotos Compartidas / Cloudflare R2
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=altezza-prod
R2_BUCKET_REGION=auto
SHARE_GALLERY_FRONTEND_BASE_URL=https://mievento.altezzaeventos.in
MOBILIARIO_FRONTEND_BASE_URL=https://mievento.altezzaeventos.in
# Optional. Leave empty when frontend proxies /api/responseAltezza same-origin.
# SHARE_GALLERY_API_BASE_URL=https://mievento.altezzaeventos.in

# optional:
# ALTEZZA_EVENTOS_DIR=/srv/altezza/images/eventos
# ALTEZZA_INVITATIONS_DIR=/srv/altezza/invitations
# ALTEZZA_TEMPLATES_DIR=/srv/altezza/templates
# ALTEZZA_TEMPLATES_PUBLIC_PATH=/scrAppaltezza/templates

# Local dev: store runtime files inside the repo (ignored by git)
# ALTEZZA_DATA_ROOT=./_local_storage

# Where event images are stored on disk (defaults to $ALTEZZA_DATA_ROOT/images/eventos)
# ALTEZZA_EVENTOS_DIR=./_local_storage/images/eventos
# ALTEZZA_INVITATIONS_DIR=./_local_storage/invitations
# ALTEZZA_TEMPLATES_DIR=./_local_storage/templates

# Public paths where assets are served (same paths used in production nginx)
# ALTEZZA_EVENTOS_PUBLIC_PATH=/scrAppaltezza/images/eventos
# ALTEZZA_INVITATIONS_PUBLIC_PATH=/scrAppaltezza/invitations
# ALTEZZA_TEMPLATES_PUBLIC_PATH=/scrAppaltezza/templates
